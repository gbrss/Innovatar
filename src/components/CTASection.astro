---
const services = ['Starlink / Internet Satelital', 'Cámaras de Seguridad', 'GPS & Flotas', 'Redes & WiFi', 'Automatización & IA', 'Soporte Técnico', 'No estoy seguro / orientación'];
const waNumber = '+56926896050';
const waText = encodeURIComponent('Hola, quiero información sobre los servicios de Innovatar.');
---

<section class="cta-section">
  <div class="cta-glow"></div>
  <div class="wrap" data-reveal>
    <div class="left">
      <h2>¿Listo para mejorar la tecnología de tu empresa?</h2>
      <p>Cotización sin costo, sin compromiso. Nuestro equipo te contacta en menos de 24 horas.</p>

      <ul class="contact-list">
        <li><span>📞</span> </li>
        <li><span>✉️</span> contacto@innovatar.cl</li>
        <li><span>🕐</span> Lun–Vie 9:00–18:00</li>
        <li><span>🚨</span> Emergencias 24/7</li>
      </ul>

      <a href={`https://wa.me/+56926896050?text=${waText}`} class="btn-whatsapp" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="#fff"><path d="M12 2a10 10 0 0 0-8.7 15l-1.3 4.7 4.8-1.3A10 10 0 1 0 12 2zm0 18a8 8 0 0 1-4.1-1.1l-.3-.2-2.9.8.8-2.8-.2-.3A8 8 0 1 1 12 20zm4.4-6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.9c-.1.2-.3.2-.5.1a6.5 6.5 0 0 1-3.2-2.8c-.2-.4.2-.4.6-1.2.1-.1 0-.3 0-.4l-.7-1.7c-.2-.5-.4-.4-.5-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3 1 2.6 1.1 2.7.1.2 1.9 2.9 4.6 4 1.7.7 2.4.8 3.2.7.5-.1 1.4-.6 1.6-1.2.2-.5.2-1 .1-1.1-.1-.1-.2-.1-.4-.2z"/></svg>
        Hablar ahora por WhatsApp
      </a>
    </div>

    <div class="right">
      <div class="form-card">
        <h3>Cuéntanos qué necesitas</h3>
        <form id="lead-form" data-wa={waNumber}>
          <label>Nombre
            <input type="text" name="nombre" placeholder="Tu nombre" required />
          </label>
          <label>WhatsApp
            <input type="tel" name="telefono" placeholder="+56 9 ..." required />
          </label>
          <label>¿Qué necesitas?
            <select name="servicio" required>
              <option value="">Selecciona un servicio</option>
              {services.map((s) => <option value={s}>{s}</option>)}
            </select>
          </label>
          <button type="submit" class="btn-primary form-submit">Enviar solicitud →</button>
          <p class="form-note">✓ Sin costo · Te contactamos en menos de 24h</p>
        </form>
        <div id="form-success" class="form-success" hidden>
          <span class="success-icon">✅</span>
          <strong>¡Casi listo!</strong>
          <p>Abrimos WhatsApp con tu solicitud. Solo presiona enviar y te responderemos en minutos.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-section {
    padding: 100px 40px;
    background: linear-gradient(135deg, #060B17 0%, #0A1428 100%);
    position: relative; overflow: hidden;
  }
  .cta-glow { position: absolute; top: -10%; right: 10%; width: 500px; height: 500px;
    background: radial-gradient(circle, rgba(14,165,233,0.08) 0%, transparent 65%); pointer-events: none; }
  .wrap { max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr;
    gap: 56px; align-items: center; position: relative; z-index: 1; }

  .left h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; line-height: 1.15; }
  .left > p { color: var(--c-text-muted); font-size: 1.05rem; margin: 16px 0 28px; line-height: 1.6; }
  .contact-list { list-style: none; display: flex; flex-direction: column; gap: 12px; margin-bottom: 28px; }
  .contact-list li { display: flex; align-items: center; gap: 12px; font-size: 0.95rem; color: rgba(255,255,255,0.8); }

  .form-card { background: var(--color-ink-card); border: 1px solid var(--c-border);
    border-radius: 20px; padding: 32px; backdrop-filter: blur(16px);
    box-shadow: 0 30px 60px rgba(0,0,0,0.4); }
  .form-card h3 { font-size: 1.3rem; font-weight: 700; margin-bottom: 22px; }
  form { display: flex; flex-direction: column; gap: 16px; }
  label { display: flex; flex-direction: column; gap: 7px; font-size: 0.82rem;
    font-weight: 600; color: rgba(255,255,255,0.7); }
  input, select {
    background: rgba(255,255,255,0.04); border: 1px solid var(--c-border);
    border-radius: 10px; padding: 12px 14px; color: #fff; font-family: inherit;
    font-size: 0.95rem; transition: border-color 0.2s, box-shadow 0.2s;
  }
  input::placeholder { color: rgba(255,255,255,0.3); }
  input:focus, select:focus { outline: none; border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(14,165,233,0.12); }
  select option { background: #0A1428; }
  .form-submit { justify-content: center; margin-top: 4px; }
  .form-note { text-align: center; font-size: 0.78rem; color: var(--c-text-muted); margin-top: 2px; }

  .form-success { text-align: center; padding: 20px 0; }
  .success-icon { font-size: 2.5rem; display: block; margin-bottom: 12px; }
  .form-success strong { font-size: 1.2rem; display: block; margin-bottom: 6px; }
  .form-success p { color: var(--c-text-muted); }

  @media (max-width: 860px) {
    .cta-section { padding: 64px 24px; }
    .wrap { grid-template-columns: 1fr; gap: 40px; }
  }
</style>

<script>
  // Fase 1: guarda el lead en Supabase (vía Worker /api/leads) Y abre WhatsApp.
  const form = document.getElementById('lead-form') as HTMLFormElement | null;
  const success = document.getElementById('form-success');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const nombre = String(data.get('nombre') || '').trim();
    const telefono = String(data.get('telefono') || '').trim();
    const servicio = String(data.get('servicio') || '').trim();
    const wa = form.dataset.wa || '+56926896050';

    // 1) Persistir el lead en la base de datos (canal confiable)
    try {
      await fetch('/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ nombre, telefono, servicio, origen: 'home_form' }),
      });
    } catch (err) {
      console.error('No se pudo guardar el lead:', err);
    }

    // 2) Abrir WhatsApp con el lead pre-cargado (canal inmediato)
    const msg =
      `Hola Innovatar 👋, quiero solicitar una cotización.\n\n` +
      `*Nombre:* ${nombre}\n` +
      `*WhatsApp:* ${telefono}\n` +
      `*Servicio de interés:* ${servicio}`;
    window.open(`https://wa.me/${wa}?text=${encodeURIComponent(msg)}`, '_blank');

    form.style.display = 'none';
    if (success) success.hidden = false;
  });
</script>
