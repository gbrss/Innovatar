---
const pillars = [
  { icon: 'M9 17H7A5 5 0 0 1 7 7h2 M15 7h2a5 5 0 0 1 0 10h-2 M8 12h8',
    title: 'Un solo proveedor',
    text: 'Starlink, cámaras, GPS, redes y automatización en un mismo contrato. Sin intermediarios ni traspasos de responsabilidad.' },
  { icon: 'M12 2v4 M12 18v4 M4.9 4.9l2.8 2.8 M16.3 16.3l2.8 2.8 M2 12h4 M18 12h4 M4.9 19.1l2.8-2.8 M16.3 7.7l2.8-2.8',
    title: 'Instalación + soporte continuo',
    text: 'No desaparecemos después de instalar. Mesa de ayuda, mantención y soporte técnico permanente para todo lo que implementamos.' },
  { icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z',
    title: 'Cobertura nacional',
    text: 'Operamos en todo Chile, desde la Región Metropolitana hasta la Araucanía y zonas rurales remotas de difícil acceso.' },
  { icon: 'M13 2 3 14h9l-1 8 10-12h-9z',
    title: 'Respuesta en menos de 24h',
    text: 'Diagnóstico, cotización y agendamiento el mismo día. Siempre con un ejecutivo asignado a tu cuenta.' },
];
---

<section class="section">
  <div class="wrap">
    <div class="head" data-reveal>
      <h2>¿Por qué elegir Innovatar?</h2>
      <p>No solo instalamos tecnología. La hacemos trabajar para ti.</p>
    </div>

    <div class="grid">
      {pillars.map((p, i) => (
        <div class="pillar" data-reveal style={`transition-delay:${i * 80}ms`}>
          <div class="pillar-icon">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#0EA5E9" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={p.icon}/></svg>
          </div>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .section { padding: 96px 40px; position: relative; }
  .wrap { max-width: 1240px; margin: 0 auto; }
  .head { text-align: center; max-width: 580px; margin: 0 auto 56px; }
  .head h2 { font-size: clamp(1.8rem, 3vw, 2.4rem); font-weight: 800; letter-spacing: -0.03em; }
  .head p { color: var(--c-text-muted); font-size: 1.1rem; margin-top: 14px; }

  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
  .pillar {
    background: var(--color-ink-card);
    border: 1px solid var(--c-border);
    border-radius: 18px;
    padding: 32px;
    transition: border-color 0.3s, transform 0.3s, background 0.3s;
  }
  .pillar:hover { border-color: rgba(14,165,233,0.25); transform: translateY(-4px);
    background: rgba(14,165,233,0.03); }
  .pillar-icon {
    width: 52px; height: 52px; border-radius: 13px; margin-bottom: 20px;
    background: linear-gradient(135deg, rgba(14,165,233,0.16), rgba(14,165,233,0.05));
    border: 1px solid rgba(14,165,233,0.2);
    display: flex; align-items: center; justify-content: center;
  }
  .pillar h3 { font-size: 1.2rem; font-weight: 700; margin-bottom: 10px; letter-spacing: -0.01em; }
  .pillar p { color: var(--c-text-muted); font-size: 0.95rem; line-height: 1.6; }

  @media (max-width: 820px) {
    .section { padding: 64px 24px; }
    .grid { grid-template-columns: 1fr; }
  }
</style>
