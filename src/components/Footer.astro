---
const cols = [
  { title: 'Servicios', links: [
    { label: 'Starlink', href: '/servicios/starlink' },
    { label: 'Cámaras', href: '/servicios/camaras-seguridad' },
    { label: 'GPS & Flotas', href: '/servicios/gps-flotas' },
    { label: 'Redes & WiFi', href: '/servicios/redes-wifi' },
    { label: 'Automatización IA', href: '/servicios/automatizacion-ia' },
    { label: 'Soporte Técnico', href: '/servicios/soporte-tecnico' },
  ]},
  { title: 'Empresa', links: [
    { label: 'Nosotros', href: '/nosotros' },
    { label: 'Casos de éxito', href: '/casos-de-exito' },
    { label: 'Mesa de Ayuda', href: '/mesa-de-ayuda' },
    { label: 'Blog', href: '/blog' },
    { label: 'Cotizar', href: '/cotizar' },
    { label: 'Contacto', href: '/contacto' },
  ]},
];
---

<footer class="footer">
  <div class="wrap">
    <div class="col brand">
      <a href="/" class="logo">
        <span class="logo-mark">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round"><path d="M5 12a7 7 0 0 1 7-7M9 12a3 3 0 0 1 3-3"/><circle cx="12" cy="12" r="1.5" fill="#fff" stroke="none"/></svg>
        </span>
        <span class="logo-text">INNOVA<span class="logo-accent">TAR</span></span>
      </a>
      <p>Tecnología que conecta, protege y automatiza negocios en todo Chile.</p>
      <div class="socials">
        <a href="#" aria-label="LinkedIn">in</a>
        <a href="#" aria-label="Instagram">ig</a>
        <a href="#" aria-label="Facebook">fb</a>
      </div>
    </div>

    {cols.map((c) => (
      <div class="col">
        <h4>{c.title}</h4>
        <ul>{c.links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    ))}

    <div class="col">
      <h4>Contacto</h4>
      <ul class="contact">
        <li>📞 +56 9 4998 1427</li>
        <li>✉️ contacto@innovatar.cl</li>
        <li>🕐 Lun–Vie 9:00–18:00</li>
        <li>🚨 Emergencias 24/7</li>
      </ul>
    </div>
  </div>

  <div class="bottom">
    <span>© 2026 Innovatar SpA · Todos los derechos reservados</span>
    <div class="legal">
      <a href="/legal/privacidad">Privacidad</a>
      <a href="/legal/terminos">Términos</a>
    </div>
  </div>
</footer>

<style>
  .footer { background: #04070F; border-top: 1px solid var(--c-border); padding: 64px 40px 32px; }
  .wrap { max-width: 1240px; margin: 0 auto;
    display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 40px; }

  .logo { display: flex; align-items: center; gap: 9px; text-decoration: none; margin-bottom: 16px; }
  .logo-mark { width: 30px; height: 30px; border-radius: 8px;
    background: linear-gradient(135deg, #0EA5E9, #0369A1);
    display: flex; align-items: center; justify-content: center; }
  .logo-text { font-weight: 900; font-size: 0.95rem; letter-spacing: -0.03em; }
  .logo-accent { color: #0EA5E9; }
  .brand p { color: var(--c-text-muted); font-size: 0.9rem; line-height: 1.6; max-width: 260px; }
  .socials { display: flex; gap: 8px; margin-top: 18px; }
  .socials a { width: 34px; height: 34px; border-radius: 8px;
    background: rgba(255,255,255,0.05); border: 1px solid var(--c-border);
    display: flex; align-items: center; justify-content: center;
    color: var(--c-text-muted); text-decoration: none; font-size: 0.75rem; font-weight: 700;
    text-transform: uppercase; transition: background 0.2s, color 0.2s; }
  .socials a:hover { background: rgba(14,165,233,0.15); color: #38BDF8; }

  .col h4 { font-size: 0.82rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: 0.06em; color: rgba(255,255,255,0.9); margin-bottom: 18px; }
  .col ul { list-style: none; display: flex; flex-direction: column; gap: 11px; }
  .col a { color: var(--c-text-muted); text-decoration: none; font-size: 0.9rem; transition: color 0.2s; }
  .col a:hover { color: #fff; }
  .contact li { color: var(--c-text-muted); font-size: 0.9rem; }

  .bottom { max-width: 1240px; margin: 48px auto 0; padding-top: 24px;
    border-top: 1px solid var(--c-border);
    display: flex; align-items: center; justify-content: space-between;
    color: var(--c-text-faint); font-size: 0.82rem; }
  .legal { display: flex; gap: 20px; }
  .legal a { color: var(--c-text-faint); text-decoration: none; }
  .legal a:hover { color: var(--c-text-muted); }

  @media (max-width: 900px) {
    .footer { padding: 48px 24px 24px; }
    .wrap { grid-template-columns: 1fr 1fr; gap: 32px; }
    .bottom { flex-direction: column; gap: 12px; text-align: center; }
  }
  @media (max-width: 520px) { .wrap { grid-template-columns: 1fr; } }
</style>
