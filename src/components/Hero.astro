---
const services = [
  { label: 'Starlink', icon: 'M5 12a7 7 0 0 1 7-7M9 12a3 3 0 0 1 3-3' },
  { label: 'Cámaras', icon: 'M3 7h4l2-2h6l2 2h4v12H3z M12 16a3 3 0 1 0 0-6 3 3 0 0 0 0 6z' },
  { label: 'GPS Flotas', icon: 'M12 2C8 2 5 5 5 9c0 5 7 13 7 13s7-8 7-13c0-4-3-7-7-7z M12 11a2 2 0 1 0 0-4 2 2 0 0 0 0 4z' },
  { label: 'Redes & WiFi', icon: 'M5 13a10 10 0 0 1 14 0 M8.5 16.5a5 5 0 0 1 7 0 M12 20h.01' },
  { label: 'Automatización', icon: 'M12 8V4H8 M4 8h16v12H4z M2 14h2 M20 14h2 M9 14v2 M15 14v2' },
  { label: 'Soporte TI', icon: 'M14.7 6.3a4 4 0 0 0-5.6 5.6L3 18v3h3l6.1-6.1a4 4 0 0 0 5.6-5.6l-2.5 2.5-2-2z' },
];

const trustCards = [
  { title: 'Instalación en 48–72h', sub: 'Instaladores certificados Starlink', delay: 350,
    icon: 'M5 12a7 7 0 0 1 7-7M9 12a3 3 0 0 1 3-3 M12 13a1 1 0 1 0 0-2 1 1 0 0 0 0 2z' },
  { title: 'Cobertura en todo Chile', sub: 'Desde RM hasta zonas rurales remotas', delay: 470,
    icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M2 12h20 M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z' },
  { title: 'Garantía de 12 meses', sub: 'Garantía completa en mano de obra', delay: 590,
    icon: 'M12 2 4 6v6c0 5 3.5 8 8 10 4.5-2 8-5 8-10V6z M9 12l2 2 4-4' },
  { title: 'Soporte técnico 24/7', sub: 'Mesa de ayuda y atención de emergencias', delay: 710,
    icon: 'M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20z M12 6v6l4 2' },
];
---

<section class="hero grid-bg">
  <!-- Glow layers -->
  <div class="glow glow-left"></div>
  <div class="glow glow-right"></div>
  <div class="vignette"></div>

  <div class="hero-grid">
    <!-- LEFT COLUMN -->
    <div class="hero-left">
      <div class="reveal" style="animation-delay:100ms">
        <span class="eyebrow"><span class="dot"></span>Tecnología certificada · Chile</span>
      </div>

      <h1 class="reveal" style="animation-delay:180ms">
        Conectamos, <span class="gradient-text">protegemos</span> y automatizamos tu negocio en Chile
      </h1>

      <p class="hero-sub reveal" style="animation-delay:260ms">
        Instalamos Starlink, cámaras de seguridad, GPS, redes y sistemas de IA
        para empresas, colegios, constructoras y parcelas en todo el país.
      </p>

      <div class="chips reveal" style="animation-delay:320ms">
        {services.map((s) => (
          <span class="chip">
            <svg viewBox="0 0 24 24" width="12" height="12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d={s.icon}/></svg>
            {s.label}
          </span>
        ))}
      </div>

      <div class="hero-ctas reveal" style="animation-delay:400ms">
        <a href="/cotizar" class="btn-primary" style="padding:14px 28px;font-size:.94rem">
          📋 Cotiza tu proyecto
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#fff" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
        <a href="/diagnostico" class="btn-ghost" style="padding:14px 22px;font-size:.94rem">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="#0EA5E9" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg>
          Diagnóstico Inteligente
        </a>
      </div>

      <div class="trust-row reveal" style="animation-delay:480ms">
        {['Instaladores certificados', 'Cobertura nacional', 'Soporte 24/7'].map((t) => (
          <span class="trust-item">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="#0EA5E9" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><path d="m9 11 3 3L22 4"/></svg>
            {t}
          </span>
        ))}
      </div>

      <div class="partners reveal" style="animation-delay:540ms">
        <span class="partners-label">Partners</span>
        <div class="partners-list">
          {['STARLINK', 'HIKVISION', 'UBIQUITI', 'MIKROTIK'].map((p) => (
            <span class="partner"><span class="partner-dot"></span>{p}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- RIGHT COLUMN -->
    <div class="hero-right">
      <div class="cards-glow"></div>

      <div class="float-badge" style="animation-delay:800ms">
        <div class="float-num">+200</div>
        <div class="float-label">proyectos</div>
      </div>

      <div class="orbit"><span class="orbit-dot"></span></div>

      {trustCards.map((c) => (
        <div class="trust-card reveal-right" style={`animation-delay:${c.delay}ms`}>
          <div class="trust-icon">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="#0EA5E9" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={c.icon}/></svg>
          </div>
          <div class="trust-text">
            <div class="trust-title">{c.title}</div>
            <div class="trust-sub">{c.sub}</div>
          </div>
          <span class="trust-pulse"></span>
        </div>
      ))}
    </div>
  </div>

  <!-- Scroll hint -->
  <div class="scroll-hint reveal" style="animation-delay:1200ms">
    <span>Scroll</span>
    <div class="scroll-line"></div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    padding-top: 72px;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }
  .glow { position: absolute; pointer-events: none; }
  .glow-left  { top: 5%; left: -8%; width: 640px; height: 640px;
    background: radial-gradient(circle, rgba(14,165,233,0.09) 0%, transparent 68%); }
  .glow-right { bottom: -5%; right: 5%; width: 560px; height: 560px;
    background: radial-gradient(circle, rgba(129,140,248,0.07) 0%, transparent 68%); }
  .vignette { position: absolute; inset: 0; pointer-events: none;
    background: radial-gradient(ellipse 90% 70% at 50% 50%, transparent 40%, rgba(6,11,23,0.8) 100%); }

  .hero-grid {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 64px;
    padding: 56px 40px 40px;
    max-width: 1240px;
    margin: 0 auto;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .hero-left { flex: 0 0 54%; max-width: 600px; }
  .hero-right { flex: 1; display: flex; flex-direction: column; gap: 12px; position: relative; }

  h1 {
    margin: 20px 0 18px;
    font-size: clamp(2.2rem, 3.5vw, 3.25rem);
    font-weight: 900;
    line-height: 1.07;
    letter-spacing: -0.035em;
    color: #fff;
  }
  .hero-sub {
    font-size: 1.02rem;
    line-height: 1.68;
    color: var(--c-text-muted);
    max-width: 510px;
    margin-bottom: 28px;
  }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 30px; }
  .chip svg { color: var(--c-text-muted); }

  .hero-ctas { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; margin-bottom: 26px; }

  .trust-row { display: flex; gap: 18px; flex-wrap: wrap; }
  .trust-item { display: inline-flex; align-items: center; gap: 6px;
    font-size: 0.78rem; color: var(--c-text-muted); font-weight: 500; }

  .partners {
    margin-top: 32px; padding-top: 24px;
    border-top: 1px solid var(--c-border);
    display: flex; align-items: center; gap: 16px;
  }
  .partners-label { font-size: 0.68rem; color: var(--c-text-faint); font-weight: 600;
    text-transform: uppercase; letter-spacing: 0.08em; flex-shrink: 0; }
  .partners-list { display: flex; gap: 20px; align-items: center; flex-wrap: wrap; }
  .partner { display: inline-flex; align-items: center; gap: 5px;
    color: var(--c-text-faint); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.06em; }
  .partner-dot { width: 16px; height: 16px; border-radius: 4px;
    background: rgba(255,255,255,0.07); flex-shrink: 0; }

  /* Right column */
  .cards-glow { position: absolute; top: 40%; left: 50%; transform: translate(-50%, -50%);
    width: 260px; height: 260px;
    background: radial-gradient(circle, rgba(14,165,233,0.18) 0%, transparent 70%);
    pointer-events: none; }

  .trust-card {
    background: var(--color-ink-card);
    border: 1px solid var(--c-border);
    border-radius: 14px;
    padding: 18px 20px;
    display: flex; align-items: center; gap: 14px;
    backdrop-filter: blur(16px);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04), 0 20px 40px rgba(0,0,0,0.35);
    transition: background 0.25s, border-color 0.25s, transform 0.25s, box-shadow 0.25s;
    position: relative; z-index: 1;
  }
  .trust-card:hover {
    background: rgba(255,255,255,0.055);
    border-color: var(--c-border-hover);
    transform: translateX(-4px);
  }
  .trust-icon {
    width: 42px; height: 42px; border-radius: 10px; flex-shrink: 0;
    background: linear-gradient(135deg, rgba(14,165,233,0.18), rgba(14,165,233,0.06));
    border: 1px solid rgba(14,165,233,0.22);
    display: flex; align-items: center; justify-content: center;
    box-shadow: 0 2px 12px rgba(14,165,233,0.15);
  }
  .trust-title { color: #fff; font-weight: 700; font-size: 0.9rem; line-height: 1.3; }
  .trust-sub { color: var(--c-text-muted); font-size: 0.78rem; margin-top: 3px; line-height: 1.4; }
  .trust-pulse { margin-left: auto; width: 6px; height: 6px; border-radius: 50%;
    background: var(--color-accent); flex-shrink: 0; animation: pulseDot 2.5s ease infinite; }

  .float-badge {
    position: absolute; top: -28px; right: -4px; z-index: 10;
    background: linear-gradient(135deg, rgba(14,165,233,0.18), rgba(14,165,233,0.06));
    border: 1px solid rgba(14,165,233,0.28);
    border-radius: 14px; padding: 12px 18px;
    backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px rgba(0,0,0,0.5), inset 0 1px 0 rgba(255,255,255,0.08);
    text-align: center;
    animation: float 5s ease-in-out infinite, fadeIn 0.8s ease forwards;
    opacity: 0;
  }
  .float-num { font-size: 2rem; font-weight: 900; color: var(--color-accent);
    line-height: 1; letter-spacing: -0.04em; }
  .float-label { font-size: 0.65rem; color: var(--c-text-muted); font-weight: 600;
    margin-top: 3px; letter-spacing: 0.05em; text-transform: uppercase; }

  .orbit { position: absolute; bottom: 20px; left: -30px;
    width: 80px; height: 80px; border-radius: 50%;
    border: 1px solid rgba(14,165,233,0.1);
    animation: rotateSlow 20s linear infinite; opacity: 0.6; }
  .orbit-dot { position: absolute; top: -3px; left: 50%; transform: translateX(-50%);
    width: 6px; height: 6px; border-radius: 50%; background: var(--color-accent); opacity: 0.6; }

  .scroll-hint {
    position: absolute; bottom: 32px; left: 50%; transform: translateX(-50%);
    display: flex; flex-direction: column; align-items: center; gap: 6px;
    opacity: 0; z-index: 1;
  }
  .scroll-hint span { font-size: 0.68rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--c-text-muted); }
  .scroll-line { width: 1px; height: 32px; background: linear-gradient(to bottom, var(--c-text-muted), transparent); }

  /* reveal final opacity */
  .reveal { animation-fill-mode: forwards; }

  @media (max-width: 980px) {
    .hero-grid { flex-direction: column; align-items: stretch; gap: 40px; padding: 40px 24px; }
    .hero-left { flex: none; max-width: 100%; }
    .hero-right { flex: none; }
    .float-badge { top: -20px; }
    .scroll-hint { display: none; }
  }
</style>
