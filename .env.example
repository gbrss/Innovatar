# ============================================================
#  INNOVATAR — Variables de entorno
#  Copia este archivo como  .env  y completa con tus valores.
#  El archivo .env está en .gitignore: NUNCA se sube al repo.
# ============================================================

# ── ESCRITURA (Worker / servidor) ──────────────────────────
# URL de tu proyecto Supabase (Settings → API → Project URL)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Service Role key (Settings → API → service_role).
# ⚠️  SECRETA. Bypassa RLS. Solo se usa en el Worker (servidor).
#     Nunca la pongas con prefijo PUBLIC_ ni la uses en el navegador.
SUPABASE_SERVICE_ROLE=eyJhbGciOi...TU_SERVICE_ROLE_KEY

# ── LECTURA (Dashboard / navegador) ────────────────────────
# Estas SÍ van al cliente (por eso el prefijo PUBLIC_). Es seguro:
# la anon key no da acceso a nada sin sesión + RLS.
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...TU_ANON_KEY
